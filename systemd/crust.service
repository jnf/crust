[Unit]
Description=crust OLED spectrum visualizer
After=cava.service
Wants=cava.service
# When cava restarts it recreates /tmp/cava.fifo; crust must reopen the fresh
# pipe or it parks on a dead one. PartOf cascades: an MPD restart restarts cava
# (its own PartOf), which in turn restarts crust here. ExecStartPre below waits
# for the new FIFO to exist before opening it.
PartOf=cava.service

[Service]
Type=simple
User=jey
# Wait for cava to create /tmp/cava.fifo before opening it
ExecStartPre=/bin/bash -c 'until [ -p /tmp/cava.fifo ]; do sleep 0.2; done'
ExecStart=/home/jey/crust
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
